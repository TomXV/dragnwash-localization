<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DragNWashLocalization</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Keep in sync with Plugin.PluginVersion; the installer shows this. -->
    <Version>1.1.2</Version>
    <FileVersion>1.1.2</FileVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>DragNWashLocalization</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The mod's icon on the Mods screen: the logo Mister ERIO drew for it. -->
  <ItemGroup>
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    These reference assemblies are NOT committed to the repo (see libs/.gitignore-equivalent
    rule in the top-level .gitignore). To build locally, copy them from your own game install:
      libs/BepInEx.dll                     <- <Game>/BepInEx/core/BepInEx.dll
      libs/0Harmony.dll                    <- <Game>/BepInEx/core/0Harmony.dll
      libs/UnityEngine.CoreModule.dll      <- <Game>/DragNWash_Data/Managed/UnityEngine.CoreModule.dll
      libs/UnityEngine.dll                 <- <Game>/DragNWash_Data/Managed/UnityEngine.dll
      libs/Unity.TextMeshPro.dll           <- <Game>/DragNWash_Data/Managed/Unity.TextMeshPro.dll
      libs/UnityEngine.UI.dll              <- <Game>/DragNWash_Data/Managed/UnityEngine.UI.dll
      libs/YarnSpinner.dll                 <- <Game>/DragNWash_Data/Managed/YarnSpinner.dll
      libs/YarnSpinner.Unity.dll           <- <Game>/DragNWash_Data/Managed/YarnSpinner.Unity.dll
      libs/Yarn.Google.Protobuf.dll        <- <Game>/DragNWash_Data/Managed/Yarn.Google.Protobuf.dll
      libs/UnityEngine.IMGUIModule.dll     <- <Game>/DragNWash_Data/Managed/UnityEngine.IMGUIModule.dll
      libs/UnityEngine.TextRenderingModule.dll <- <Game>/DragNWash_Data/Managed/UnityEngine.TextRenderingModule.dll
      libs/Unity.InputSystem.dll           <- <Game>/DragNWash_Data/Managed/Unity.InputSystem.dll
      libs/UnityEngine.AssetBundleModule.dll <- <Game>/DragNWash_Data/Managed/UnityEngine.AssetBundleModule.dll
      libs/Naelstrof.UnityScriptableSettings.dll <- <Game>/DragNWash_Data/Managed/Naelstrof.UnityScriptableSettings.dll
      libs/Unity.Localization.dll          <- <Game>/DragNWash_Data/Managed/Unity.Localization.dll
      libs/UnityEngine.TextCoreFontEngineModule.dll <- <Game>/DragNWash_Data/Managed/UnityEngine.TextCoreFontEngineModule.dll

    The DragNWash.ModFramework*.dll references do not come from the game. They
    are built from the framework's own repository and copied into libs/ by
    tools/pack.ps1 (see the comment at the top of that script). Building this
    project by hand needs them there too.

    tools/pack.ps1 checks this same list before it builds; keep the two in step.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>libs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>libs\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YarnSpinner">
      <HintPath>libs\YarnSpinner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Yarn.Google.Protobuf">
      <HintPath>libs\Yarn.Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YarnSpinner.Unity">
      <HintPath>libs\YarnSpinner.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>libs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>libs\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>libs\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>libs\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DragNWash.ModFramework">
      <HintPath>libs\DragNWash.ModFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DragNWash.ModFramework.Dialogue">
      <HintPath>libs\DragNWash.ModFramework.Dialogue.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DragNWash.ModFramework.ToolWindow">
      <HintPath>libs\DragNWash.ModFramework.ToolWindow.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DragNWash.ModFramework.Assets">
      <HintPath>libs\DragNWash.ModFramework.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DragNWash.ModFramework.Saves">
      <HintPath>libs\DragNWash.ModFramework.Saves.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DragNWash.ModFramework.Text">
      <HintPath>libs\DragNWash.ModFramework.Text.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Naelstrof.UnityScriptableSettings">
      <HintPath>libs\Naelstrof.UnityScriptableSettings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>libs\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
