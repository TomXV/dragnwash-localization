# build output
bin/
obj/
*.dll
*.pdb

# release packaging (tools/pack.ps1)
release/
*.zip

# game reference assemblies copied locally for compiling against (never commit game files)
libs/

# generated by the plugin at runtime (F6 dump, auto-discovered strings) - contains the
# game's own copyrighted text, so each contributor regenerates it locally instead
Translations/_discovered/

# IDE
.vs/
*.user
*.suo

# OS
Thumbs.db
.DS_Store

# editor lock files (LibreOffice/Excel leave these next to a CSV while it is open)
.~lock.*#
~$*

# Python bytecode from tools/
__pycache__/

# Dragn Wash Localization Editor
dwloc.exe
dwloc*.log
